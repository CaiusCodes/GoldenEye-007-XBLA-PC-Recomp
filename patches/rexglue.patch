diff --git a/src/graphics/shaders/ge_backdrop.cs.hlsl b/src/graphics/shaders/ge_backdrop.cs.hlsl
new file mode 100644
index 0000000..1241a21
--- /dev/null
+++ b/src/graphics/shaders/ge_backdrop.cs.hlsl
@@ -0,0 +1,156 @@
+// ge - menu backdrop compute shader.
+//
+// Runs in-place over the final guest-output image (R10G10B10A2_UNORM) right
+// after gamma/FXAA in the D3D12 swap, before the colour grade. Every pixel
+// that still holds the key colour the game painted behind its front-end
+// folder (and the folder's back cover edges) is replaced with the backdrop
+// picture, placed as it is across the whole window (the game draws the
+// same picture into any side bars).
+//
+// The folder itself is trimmed to a finished shape lying on the desk: the left
+// cover ends a little inside the picture with a rounded corner and a thin
+// darker rim, and the desk beside the folder takes a soft shadow from the
+// outline. (The folder can also end above the bottom, see kFolderBottom.)
+//
+// Scalars only in the cbuffer to keep a tight, straddle-free 32-bit-constant
+// layout (12 dwords) matching BackdropConstants on the C++ side.
+
+cbuffer push_consts : register(b0) {
+  uint2 xe_backdrop_size;   // 0
+  float xe_uv_scale_x;      // 8
+  float xe_uv_scale_y;      // 12
+  float xe_uv_offset_x;     // 16
+  float xe_uv_offset_y;     // 20
+  float xe_key_r;           // 24
+  float xe_key_g;           // 28
+  float xe_key_b;           // 32
+  float xe_key_tolerance;   // 36
+  uint xe_layout_4x3;       // 40  1 = 4:3 window: only replace the key
+  uint xe_fill_black;       // 44  1 = paint everything black (boot cover)
+};
+
+Texture2D<float4> xe_image : register(t0);
+SamplerState xe_sampler : register(s0);
+RWTexture2D<float4> xe_dest : register(u0);
+
+// The folder in the front end's 1280x720 picture units.
+static const float kCoverLeft = 28.0;      // where the left cover now ends
+static const float kCoverTop = 22.0;       // top edge of the left cover
+static const float kSpineEnd = 148.0;      // the cover meets the spine here
+static const float kBoardTop = 28.0;       // top edge of the board
+static const float kBoardRight = 1065.0;   // right edge of the board
+static const float kChamferX = 1016.0;     // top right corner: x - y = 1016
+// Where the folder ends at the bottom. Trimming it 20 units above the screen
+// bottom (700) worked but was not liked, so by default it runs off the screen.
+static const float kFolderBottom = 100000.0;
+static const float kCorner = 22.0;         // radius of the rounded corners
+static const float2 kShadowShift = float2(5.0, 7.0);  // the lamp is top left
+static const float kShadowReach = 22.0;
+static const float kShadowStrength = 0.55;
+static const float kFar = 100000.0;
+
+// Signed distance to a rounded box (negative inside).
+float sd_round_box(float2 p, float2 lo, float2 hi, float r) {
+  float2 centre = 0.5 * (lo + hi);
+  float2 half_size = 0.5 * (hi - lo) - r;
+  float2 q = abs(p - centre) - half_size;
+  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
+}
+
+[numthreads(8, 8, 1)]
+void main(uint3 xe_thread_id : SV_DispatchThreadID) {
+  [branch] if (xe_thread_id.x >= xe_backdrop_size.x || xe_thread_id.y >= xe_backdrop_size.y) {
+    return;
+  }
+  int2 coord = int2(xe_thread_id.xy);
+  [branch] if (xe_fill_black != 0u) {
+    xe_dest[coord] = float4(0.0, 0.0, 0.0, 1.0);
+    return;
+  }
+  float3 c = xe_dest[coord].rgb;
+  // The key (16, 0, 16) comes out of the game's gamma ramp as some dark
+  // (k, 0, k): match that shape rather than one value, so any ramp works.
+  // xe_key_r/b bound k, xe_key_tolerance is the allowed difference.
+  float2 pos = (float2(xe_thread_id.xy) + 0.5) / float2(xe_backdrop_size);
+  bool key = c.g <= xe_key_tolerance && abs(c.r - c.b) <= xe_key_tolerance &&
+             c.r >= xe_key_r && c.r <= xe_key_b;
+  // The folder's back cover shows as a light green strip along the top and
+  // down the right beyond the inner frame; like the rest of the backdrop it
+  // becomes desk, so the folder looks like it lies on the desk. All of it
+  // except the paper clip, which pokes into the top strip (light grey).
+  float hi = max(c.r, max(c.g, c.b));
+  float lo = min(c.r, min(c.g, c.b));
+  bool clip = hi > 0.25 && hi - lo < 0.08;
+  // The red menu crosshair can move over the edges too; keep it.
+  // (Bright pure red: the darker red of the stamp must not count.)
+  bool crosshair = c.r > 0.6 && c.g < c.r * 0.3 && c.b < c.r * 0.3;
+  float2 p = pos * float2(1280.0, 720.0);
+  float px_per_unit = float(xe_backdrop_size.y) / 720.0;
+  // The paper clip of whichever photo is on the page (main menu: left; mission
+  // briefing: right) pokes above the board's top edge.
+  bool keep_clip = clip && p.y < 40.0;
+
+  // Distance outside the visible outline (negative inside), in units. Left of
+  // the spine it is the left cover (rounded top left and bottom left corners);
+  // from the spine on it is the board's right edge, chamfered top right corner
+  // and bottom edge (rounded bottom right corner). The board's top edge is cut
+  // by position and brightness below instead.
+  bool left_zone = p.x < kSpineEnd;
+  float edge_d;
+  [branch] if (left_zone) {
+    edge_d = sd_round_box(p, float2(kCoverLeft, kCoverTop), float2(kFar, kFolderBottom), kCorner);
+  } else {
+    edge_d = sd_round_box(p, float2(-kFar, -kFar), float2(kBoardRight, kFolderBottom), kCorner);
+    edge_d = max(edge_d, (p.x - p.y - kChamferX) * 0.7071);
+  }
+  // Within a couple of pixels of the outline, or outside it: the edge is
+  // anti-aliased and given a thin darker rim so it reads as a cut edge.
+  bool soft_edge = !crosshair && !keep_clip && edge_d * px_per_unit > -2.5;
+
+  // Top edge from the spine on: everything above the board's top edge. In the
+  // top left, above the spine and its light band, the back cover's strip meets
+  // shapes of its own (spine top at about y 21.5, teal corner, band), so cut
+  // there by brightness (the strip is light, those are dark) with a soft edge.
+  bool top_left = p.x > kSpineEnd && p.x < 232.0;
+  float top_edge = top_left ? 27.5 : kBoardTop;
+  bool top_cut = !left_zone && p.y < top_edge && !crosshair && !keep_clip;
+  // A 4:3 window lays the front end out for 4:3, so the folder shape measured
+  // for the 16:9 picture does not apply: only the key is replaced there.
+  [branch] if (xe_layout_4x3 != 0u) {
+    top_cut = false;
+    soft_edge = false;
+  }
+  [branch] if (!key && !top_cut && !soft_edge) {
+    return;
+  }
+
+  // Soft contact shadow of the whole folder on the desk, cast down and to the
+  // right: distance outside the outline, moved by the shadow shift. The cover
+  // and spine stand a little higher than the board, so they are two boxes.
+  float2 q = p - kShadowShift;
+  float dist = min(
+      sd_round_box(q, float2(kCoverLeft, kCoverTop), float2(232.0, kFolderBottom), kCorner),
+      sd_round_box(q, float2(150.0, kBoardTop), float2(kBoardRight, kFolderBottom), kCorner));
+  float shadow = 1.0 - kShadowStrength * (1.0 - smoothstep(0.0, kShadowReach, dist)) *
+                           (1.0 - smoothstep(704.0, 719.0, p.y));  // none at the picture bottom
+
+  float alpha = 1.0;
+  float3 base = c;
+  [branch] if (!key) {
+    [branch] if (top_cut) {
+      [branch] if (top_left) {
+        float n = dot(c, float3(0.3, 0.59, 0.11));
+        alpha = p.y < 20.0 ? 1.0 : smoothstep(0.11, 0.16, n);
+      }
+    } else {
+      // 0 inside (2 px or more from the edge) up to 1 outside; half at the edge.
+      alpha = saturate(edge_d * px_per_unit + 0.5);
+      float rim = saturate(1.0 + edge_d * px_per_unit * 0.5);
+      base = c * (1.0 - 0.3 * rim);
+    }
+  }
+  float2 uv = pos;
+  uv = uv * float2(xe_uv_scale_x, xe_uv_scale_y) + float2(xe_uv_offset_x, xe_uv_offset_y);
+  float3 desk = xe_image.SampleLevel(xe_sampler, uv, 0.0).rgb * shadow;
+  xe_dest[coord] = float4(lerp(base, desk, alpha), 1.0);
+}
diff --git a/src/graphics/shaders/ge_grade.cs.hlsl b/src/graphics/shaders/ge_grade.cs.hlsl
new file mode 100644
index 0000000..9c3ab08
--- /dev/null
+++ b/src/graphics/shaders/ge_grade.cs.hlsl
@@ -0,0 +1,61 @@
+// ge - colour-grade post-process compute shader.
+//
+// Runs in-place over the final guest-output image (R10G10B10A2_UNORM) right
+// after gamma/FXAA in the D3D12 swap. Applies a per-pixel grade chain:
+// temperature -> brightness -> contrast -> tint -> saturation -> vibrance ->
+// gamma. All neutral defaults = identity (no visible change).
+//
+// Scalars only in the cbuffer to keep a tight, straddle-free 32-bit-constant
+// layout (12 dwords) matching GradeConstants on the C++ side.
+
+cbuffer push_consts : register(b0) {
+  uint2 xe_grade_size;      // 0
+  float xe_brightness;      // 8   (-1..1, added)
+  float xe_contrast;        // 12  (0..2, 1=none)
+  float xe_saturation;      // 16  (0..2, 1=none)
+  float xe_vibrance;        // 20  (-1..1)
+  float xe_temperature;     // 24  (-1..1, warm/cool)
+  float xe_gamma;           // 28  (0.3..3, 1=none)
+  float xe_tint_r;          // 32
+  float xe_tint_g;          // 36
+  float xe_tint_b;          // 40
+  float xe_tint_strength;   // 44  (0..1)
+};
+
+RWTexture2D<float4> xe_dest : register(u0);
+
+[numthreads(8, 8, 1)]
+void main(uint3 xe_thread_id : SV_DispatchThreadID) {
+  [branch] if (xe_thread_id.x >= xe_grade_size.x || xe_thread_id.y >= xe_grade_size.y) {
+    return;
+  }
+  int2 coord = int2(xe_thread_id.xy);
+  float3 c = xe_dest[coord].rgb;
+
+  // Temperature: push warm (R up / B down) or cool (opposite).
+  c.r += xe_temperature * 0.10;
+  c.b -= xe_temperature * 0.10;
+
+  // Brightness (additive) then contrast about mid-grey.
+  c += xe_brightness;
+  c = (c - 0.5) * xe_contrast + 0.5;
+
+  // Tint: multiply toward the tint colour by strength.
+  float3 tint = float3(xe_tint_r, xe_tint_g, xe_tint_b);
+  c = lerp(c, c * tint, xe_tint_strength);
+
+  // Saturation about luma.
+  float luma = dot(max(c, 0.0), float3(0.2126, 0.7152, 0.0722));
+  c = lerp(float3(luma, luma, luma), c, xe_saturation);
+
+  // Vibrance: boost less-saturated pixels more.
+  float mx = max(c.r, max(c.g, c.b));
+  float mn = min(c.r, min(c.g, c.b));
+  float sat = mx - mn;
+  c = lerp(float3(luma, luma, luma), c, 1.0 + xe_vibrance * (1.0 - saturate(sat)));
+
+  // Gamma.
+  c = pow(max(c, 0.0001), 1.0 / xe_gamma);
+
+  xe_dest[coord] = float4(saturate(c), 1.0);
+}
