+// ---------------------------------------------------------------------------
+// ge: texture replacement. Recognises a few textures of the game by size and a
+// hash of their guest data, and rewrites them in guest memory, from a PNG
+// beside the executable (textures\<name>.png, exactly the original size), just
+// before they are uploaded. Only tiled DXT1 2D textures (k8in16 byte order)
+// are supported: encoded to DXT1, mip chain included down to the packed tail
+// (the tiny packed levels keep the original data), tiled and byte swapped.
+// ---------------------------------------------------------------------------
+namespace {
+
+struct GeReplacement {
+  uint64_t hash;  // XXH3 of the original base level data, 0 = log only
+  uint32_t width, height, max_level;
+  const char* name;  // textures\<name>.png
+};
+
+// Hashes of the original data, from the ge_log_textures output ("GEREPL candidate ... hash=").
+const GeReplacement kGeReplacements[] = {
+    {0x36A2FEDF41BB63E8ull, 1124, 714, 9, "folder_cover"},
+    {0xECEC23D24447D8BAull, 512, 512, 9, "page_crest"},
+    {0xA3EEE5B70378A508ull, 512, 512, 9, "page_plain"},
+    {0x26B888F8ABAB91B4ull, 32, 64, 0, "paperclip"},
+};
+
+struct GeRgb {
+  uint8_t r, g, b;
+};
+
+struct GeImage {
+  uint32_t w = 0, h = 0;
+  std::vector<GeRgb> px;
+};
+
+uint16_t GeTo565(float r, float g, float b) {
+  auto q = [](float v, int max) {
+    int i = int(std::lround(v * float(max) / 255.0f));
+    return std::clamp(i, 0, max);
+  };
+  return uint16_t((q(r, 31) << 11) | (q(g, 63) << 5) | q(b, 31));
+}
+
+void GeFrom565(uint16_t c, float out[3]) {
+  out[0] = float((c >> 11) & 31) * 255.0f / 31.0f;
+  out[1] = float((c >> 5) & 63) * 255.0f / 63.0f;
+  out[2] = float(c & 31) * 255.0f / 31.0f;
+}
+
+void GePalette(uint16_t c0, uint16_t c1, float pal[4][3]) {
+  GeFrom565(c0, pal[0]);
+  GeFrom565(c1, pal[1]);
+  for (int a = 0; a < 3; ++a) {
+    pal[2][a] = (2.0f * pal[0][a] + pal[1][a]) / 3.0f;
+    pal[3][a] = (pal[0][a] + 2.0f * pal[1][a]) / 3.0f;
+  }
+}
+
+int GeNearest(const GeRgb& p, const float pal[4][3]) {
+  float best = 1e30f;
+  int bi = 0;
+  for (int k = 0; k < 4; ++k) {
+    const float dr = p.r - pal[k][0], dg = p.g - pal[k][1], db = p.b - pal[k][2];
+    const float d = dr * dr + dg * dg + db * db;
+    if (d < best) {
+      best = d;
+      bi = k;
+    }
+  }
+  return bi;
+}
+
+// One 4x4 block to 8 DXT1 bytes (standard little-endian block layout).
+void GeEncodeDxt1Block(const GeRgb blk[16], uint8_t out[8]) {
+  float mean[3] = {0, 0, 0};
+  for (int i = 0; i < 16; ++i) {
+    mean[0] += blk[i].r;
+    mean[1] += blk[i].g;
+    mean[2] += blk[i].b;
+  }
+  for (float& m : mean) m /= 16.0f;
+  // Principal axis of the colours (power iteration on the covariance).
+  float cov[3][3] = {};
+  for (int i = 0; i < 16; ++i) {
+    const float d[3] = {blk[i].r - mean[0], blk[i].g - mean[1], blk[i].b - mean[2]};
+    for (int a = 0; a < 3; ++a)
+      for (int b = 0; b < 3; ++b) cov[a][b] += d[a] * d[b];
+  }
+  float axis[3] = {0.57735f, 0.57735f, 0.57735f};
+  for (int it = 0; it < 6; ++it) {
+    float n[3];
+    for (int a = 0; a < 3; ++a)
+      n[a] = cov[a][0] * axis[0] + cov[a][1] * axis[1] + cov[a][2] * axis[2];
+    const float len = std::sqrt(n[0] * n[0] + n[1] * n[1] + n[2] * n[2]);
+    if (len < 1e-6f) break;
+    for (int a = 0; a < 3; ++a) axis[a] = n[a] / len;
+  }
+  float lo = 1e9f, hi = -1e9f;
+  for (int i = 0; i < 16; ++i) {
+    const float t = (blk[i].r - mean[0]) * axis[0] + (blk[i].g - mean[1]) * axis[1] +
+                    (blk[i].b - mean[2]) * axis[2];
+    lo = std::min(lo, t);
+    hi = std::max(hi, t);
+  }
+  // Pull the ends in a little (the usual range fit inset), then refine.
+  float c0f[3], c1f[3];
+  const float inset = (hi - lo) / 16.0f;
+  for (int a = 0; a < 3; ++a) {
+    c0f[a] = std::clamp(mean[a] + axis[a] * (hi - inset), 0.0f, 255.0f);
+    c1f[a] = std::clamp(mean[a] + axis[a] * (lo + inset), 0.0f, 255.0f);
+  }
+  uint16_t c0 = GeTo565(c0f[0], c0f[1], c0f[2]);
+  uint16_t c1 = GeTo565(c1f[0], c1f[1], c1f[2]);
+  for (int pass = 0; pass < 3; ++pass) {
+    if (c0 < c1) std::swap(c0, c1);
+    float pal[4][3];
+    GePalette(c0, c1, pal);
+    // Weight of c0 for each DXT1 index (0 = c0, 1 = c1, 2 = 2/3 c0, 3 = 1/3 c0).
+    static const float w0[4] = {1.0f, 0.0f, 2.0f / 3.0f, 1.0f / 3.0f};
+    double sa = 0, sb = 0, sab = 0, sx[3] = {}, sy[3] = {};
+    for (int i = 0; i < 16; ++i) {
+      const int bi = GeNearest(blk[i], pal);
+      const float al = w0[bi], be = 1.0f - al;
+      sa += al * al;
+      sb += be * be;
+      sab += al * be;
+      sx[0] += al * blk[i].r; sx[1] += al * blk[i].g; sx[2] += al * blk[i].b;
+      sy[0] += be * blk[i].r; sy[1] += be * blk[i].g; sy[2] += be * blk[i].b;
+    }
+    const double det = sa * sb - sab * sab;
+    if (std::fabs(det) < 1e-9) break;
+    float n0[3], n1[3];
+    for (int a = 0; a < 3; ++a) {
+      n0[a] = float(std::clamp((sx[a] * sb - sy[a] * sab) / det, 0.0, 255.0));
+      n1[a] = float(std::clamp((sy[a] * sa - sx[a] * sab) / det, 0.0, 255.0));
+    }
+    c0 = GeTo565(n0[0], n0[1], n0[2]);
+    c1 = GeTo565(n1[0], n1[1], n1[2]);
+  }
+  if (c0 < c1) std::swap(c0, c1);
+  uint32_t bits = 0;
+  if (c0 != c1) {  // equal ends would select the 3-colour mode: use index 0 only
+    float pal[4][3];
+    GePalette(c0, c1, pal);
+    for (int i = 0; i < 16; ++i) bits |= uint32_t(GeNearest(blk[i], pal)) << (2 * i);
+  }
+  out[0] = uint8_t(c0 & 0xFF);
+  out[1] = uint8_t(c0 >> 8);
+  out[2] = uint8_t(c1 & 0xFF);
+  out[3] = uint8_t(c1 >> 8);
+  out[4] = uint8_t(bits);
+  out[5] = uint8_t(bits >> 8);
+  out[6] = uint8_t(bits >> 16);
+  out[7] = uint8_t(bits >> 24);
+}
+
+GeImage GeHalve(const GeImage& src) {
+  GeImage dst;
+  dst.w = std::max(1u, src.w >> 1);
+  dst.h = std::max(1u, src.h >> 1);
+  dst.px.resize(size_t(dst.w) * dst.h);
+  for (uint32_t y = 0; y < dst.h; ++y) {
+    for (uint32_t x = 0; x < dst.w; ++x) {
+      int r = 0, g = 0, b = 0;
+      for (uint32_t dy = 0; dy < 2; ++dy) {
+        for (uint32_t dx = 0; dx < 2; ++dx) {
+          const GeRgb& p =
+              src.px[size_t(std::min(y * 2 + dy, src.h - 1)) * src.w + std::min(x * 2 + dx, src.w - 1)];
+          r += p.r;
+          g += p.g;
+          b += p.b;
+        }
+      }
+      dst.px[size_t(y) * dst.w + x] = {uint8_t((r + 2) / 4), uint8_t((g + 2) / 4),
+                                       uint8_t((b + 2) / 4)};
+    }
+  }
+  return dst;
+}
+
+// The replacement pictures, loaded once: name -> image (empty if unusable).
+const GeImage& GeLoadReplacementImage(const std::string& name, uint32_t want_w, uint32_t want_h) {
+  static std::map<std::string, GeImage> cache;
+  auto it = cache.find(name);
+  if (it != cache.end()) return it->second;
+  GeImage& img = cache[name];
+  // Game\resources\textures (beside the exe in older layouts).
+  const std::filesystem::path exe_folder = rex::filesystem::GetExecutableFolder();
+  std::ifstream file(exe_folder / "resources" / "textures" / (name + ".png"), std::ios::binary);
+  if (!file) {
+    file.clear();
+    file.open(exe_folder / "textures" / (name + ".png"), std::ios::binary);
+  }
+  if (!file) return img;
+  std::vector<uint8_t> bytes((std::istreambuf_iterator<char>(file)),
+                             std::istreambuf_iterator<char>());
+  int w = 0, h = 0;
+  std::vector<uint8_t> rgba = rex::ui::DecodeImageRGBA(bytes.data(), bytes.size(), w, h);
+  if (rgba.empty() || uint32_t(w) != want_w || uint32_t(h) != want_h) {
+    REXGPU_WARN("ge: texture {} must be a PNG of exactly {}x{} (it is {}x{}), not used",
+                name, want_w, want_h, w, h);
+    return img;
+  }
+  img.w = uint32_t(w);
+  img.h = uint32_t(h);
+  img.px.resize(size_t(w) * h);
+  for (size_t i = 0; i < img.px.size(); ++i) {
+    img.px[i] = {rgba[i * 4], rgba[i * 4 + 1], rgba[i * 4 + 2]};
+  }
+  REXGPU_INFO("ge: replacement texture {} loaded ({}x{})", name, w, h);
+  return img;
+}
+
+}  // namespace
+
+// ---------------------------------------------------------------------------
+// ge: button icons. The A / B button pictures of the menus (64x64 tiled 8888)
+// are blanked in guest memory while the game says no controller is connected
+// (ge_hide_button_icons) and put back when one is. The original data is kept
+// per address; an address whose data is neither the original nor blank has
+// been reused by the game and is forgotten.
+// ---------------------------------------------------------------------------
+namespace {
+
+struct GeIconState {
+  std::vector<uint8_t> original;
+  uint64_t original_hash = 0;
+  uint64_t blank_hash = 0;
+};
+std::map<uint32_t, GeIconState> g_ge_icons;  // base address -> state
+std::mutex g_ge_icons_mutex;
+
+// XXH3 of the original base level data of the icons.
+const uint64_t kGeIconHashes[] = {
+    0x7F9DFBB82F6FC4ADull,  // A
+    0x43542A8F53233947ull,  // B
+    0xDD2A7EFD20DE3A6Aull,  // Start
+};
+
+bool GeHideIconsWanted() {
+  static std::chrono::steady_clock::time_point last{};
+  static bool value = false;
+  const auto now = std::chrono::steady_clock::now();
+  if (now - last > std::chrono::milliseconds(250)) {
+    last = now;
+    value = rex::cvar::GetFlagByName("ge_hide_button_icons") == "true";
+  }
+  return value;
+}
+
+}  // namespace
+
+template <typename Key>
+static void GeHandleIcon(const Key& key, const texture_util::TextureGuestLayout& layout,
+                         rex::memory::Memory& memory) {
+  if (key.format != xenos::TextureFormat::k_8_8_8_8 || key.GetWidth() != 64 ||
+      key.GetHeight() != 64 || !key.tiled || key.mip_max_level != 0) {
+    return;
+  }
+  const uint32_t address = key.base_page << 12;
+  const uint32_t size = layout.base.level_data_extent_bytes;
+  uint8_t* data = memory.TranslatePhysical<uint8_t*>(address);
+  if (!data || !size) return;
+  std::lock_guard<std::mutex> lock(g_ge_icons_mutex);
+  auto it = g_ge_icons.find(address);
+  const uint64_t hash = XXH3_64bits(data, size);
+  if (it == g_ge_icons.end()) {
+    if (REXCVAR_GET(ge_log_textures)) {
+      REXGPU_INFO("GEICON candidate base={:08X} hash={:016X}", address, hash);
+    }
+    bool known = false;
+    for (uint64_t h : kGeIconHashes) known = known || (h && h == hash);
+    if (!known) return;
+    GeIconState state;
+    state.original.assign(data, data + size);
+    state.original_hash = hash;
+    std::vector<uint8_t> zeros(size, 0);
+    state.blank_hash = XXH3_64bits(zeros.data(), size);
+    it = g_ge_icons.emplace(address, std::move(state)).first;
+  } else if (hash != it->second.original_hash && hash != it->second.blank_hash) {
+    g_ge_icons.erase(it);  // the memory holds something else now
+    return;
+  }
+  const bool hide = GeHideIconsWanted();
+  memory.EnablePhysicalMemoryAccessCallbacks(address, size, false, false);
+  if (hide) {
+    std::memset(data, 0, size);
+  } else {
+    std::memcpy(data, it->second.original.data(), size);
+  }
+}
+
+// Called before a texture's guest ranges are requested: swaps in the picture.
+template <typename Key>
+static void GeApplyTextureReplacement(const Key& key,
+                                      const texture_util::TextureGuestLayout& layout,
+                                      rex::memory::Memory& memory) {
+  GeHandleIcon(key, layout, memory);
+  if (key.format != xenos::TextureFormat::k_DXT1 ||
+      key.dimension != xenos::DataDimension::k2DOrStacked || !key.tiled ||
+      key.endianness != xenos::Endian::k8in16 || key.depth_or_array_size_minus_1 != 0) {
+    return;
+  }
+  const GeReplacement* candidates[8];
+  size_t candidate_count = 0;
+  for (const GeReplacement& r : kGeReplacements) {
+    if (r.width == key.GetWidth() && r.height == key.GetHeight() &&
+        r.max_level == key.mip_max_level && candidate_count < 8) {
+      candidates[candidate_count++] = &r;
+    }
+  }
+  if (!candidate_count) return;
+  const uint32_t base_address = key.base_page << 12;
+  const uint32_t mips_address = key.mip_page << 12;
+  const uint8_t* base_data = memory.TranslatePhysical<const uint8_t*>(base_address);
+  if (!base_data) return;
+  const uint64_t hash = XXH3_64bits(base_data, layout.base.level_data_extent_bytes);
+  if (REXCVAR_GET(ge_log_textures)) {
+    REXGPU_INFO("GEREPL candidate {}x{} base={:08X} hash={:016X}", key.GetWidth(), key.GetHeight(),
+                base_address, hash);
+  }
+  const GeReplacement* match = nullptr;
+  for (size_t i = 0; i < candidate_count; ++i) {
+    if (candidates[i]->hash && candidates[i]->hash == hash) match = candidates[i];
+  }
+  if (!match) return;
+  const GeImage& source = GeLoadReplacementImage(match->name, key.GetWidth(), key.GetHeight());
+  if (source.px.empty()) return;
+
+  // Levels to write: 0 up to (not including) the packed tail.
+  uint32_t levels = key.mip_max_level + 1;
+  if (layout.packed_level != UINT32_MAX) levels = std::min(levels, layout.packed_level);
+  levels = std::max(levels, 1u);
+
+  // Unprotect the ranges first so the direct write is not seen as a game write.
+  memory.EnablePhysicalMemoryAccessCallbacks(base_address, layout.base.level_data_extent_bytes,
+                                             false, false);
+  if (levels > 1) {
+    memory.EnablePhysicalMemoryAccessCallbacks(mips_address, layout.mips_total_extent_bytes, false,
+                                               false);
+  }
+  GeImage level_image = source;
+  for (uint32_t level = 0; level < levels; ++level) {
+    if (level) level_image = GeHalve(level_image);
+    const texture_util::TextureGuestLayout::Level& lv = level ? layout.mips[level] : layout.base;
+    uint8_t* dst = memory.TranslatePhysical<uint8_t*>(
+        level ? mips_address + layout.mip_offsets_bytes[level] : base_address);
+    if (!dst) break;
+    const uint32_t pitch_blocks = lv.row_pitch_bytes / 8;
+    const uint32_t bw = (level_image.w + 3) / 4, bh = (level_image.h + 3) / 4;
+    for (uint32_t by = 0; by < bh; ++by) {
+      for (uint32_t bx = 0; bx < bw; ++bx) {
+        GeRgb blk[16];
+        for (uint32_t y = 0; y < 4; ++y) {
+          for (uint32_t x = 0; x < 4; ++x) {
+            blk[y * 4 + x] = level_image.px[size_t(std::min(by * 4 + y, level_image.h - 1)) *
+                                                level_image.w +
+                                            std::min(bx * 4 + x, level_image.w - 1)];
+          }
+        }
+        uint8_t enc[8];
+        GeEncodeDxt1Block(blk, enc);
+        uint8_t sw[8];  // 8in16 byte order: swap each pair of bytes
+        for (int i = 0; i < 8; i += 2) {
+          sw[i] = enc[i + 1];
+          sw[i + 1] = enc[i];
+        }
+        const int32_t off =
+            texture_util::GetTiledOffset2D(int32_t(bx), int32_t(by), pitch_blocks, 3);
+        std::memcpy(dst + off, sw, 8);
+      }
+    }
+  }
+  REXGPU_INFO("ge: replaced texture {} ({}x{}, {} levels) at {:08X}", match->name, key.GetWidth(),
+              key.GetHeight(), levels, base_address);
+}
