+bool D3D12CommandProcessor::EnsureBackdropTexture(int kind) {
+  if (backdrop_texture_[kind]) return true;
+  if (backdrop_load_tried_[kind]) return false;
+  backdrop_load_tried_[kind] = true;
+
+  // ge: the port's own pictures live in Game\resources (beside the exe in older layouts).
+  const std::filesystem::path exe_folder = rex::filesystem::GetExecutableFolder();
+  std::filesystem::path folder = exe_folder;
+  std::filesystem::path path;
+  std::ifstream file;
+  for (const std::filesystem::path& dir : {exe_folder / "resources", exe_folder}) {
+    for (const char* name : {kind ? "menu-backdrop-219.png" : "menu-backdrop-169.png",
+                             "menu-backdrop.png"}) {
+      path = dir / name;
+      file.open(path, std::ios::binary);
+      if (file) break;
+      file.clear();
+    }
+    if (file) {
+      folder = dir;
+      break;
+    }
+  }
+  if (!file) {
+    REXGPU_INFO("ge: no menu backdrop picture for shape {} in {}", kind, folder.string());
+    return false;
+  }
+  std::vector<uint8_t> bytes((std::istreambuf_iterator<char>(file)),
+                             std::istreambuf_iterator<char>());
+  int width = 0, height = 0;
+  std::vector<uint8_t> pixels = ui::DecodeImageRGBA(bytes.data(), bytes.size(), width, height);
+  if (pixels.empty() || width <= 0 || height <= 0 || width > 8192 || height > 8192) {
+    REXGPU_WARN("ge: could not read the menu backdrop picture {}", path.string());
+    return false;
+  }
+
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  D3D12_RESOURCE_DESC tex_desc = {};
+  tex_desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+  tex_desc.Width = UINT64(width);
+  tex_desc.Height = UINT(height);
+  tex_desc.DepthOrArraySize = 1;
+  tex_desc.MipLevels = 1;
+  tex_desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+  tex_desc.SampleDesc.Count = 1;
+  tex_desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+  if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesDefault,
+                                             D3D12_HEAP_FLAG_NONE, &tex_desc,
+                                             D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                             IID_PPV_ARGS(&backdrop_texture_[kind])))) {
+    backdrop_texture_[kind].Reset();
+    return false;
+  }
+  D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint;
+  UINT64 upload_size = 0;
+  device->GetCopyableFootprints(&tex_desc, 0, 1, 0, &footprint, nullptr, nullptr, &upload_size);
+  D3D12_RESOURCE_DESC buf_desc;
+  ui::d3d12::util::FillBufferResourceDesc(buf_desc, upload_size, D3D12_RESOURCE_FLAG_NONE);
+  if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesUpload,
+                                             D3D12_HEAP_FLAG_NONE, &buf_desc,
+                                             D3D12_RESOURCE_STATE_GENERIC_READ, nullptr,
+                                             IID_PPV_ARGS(&backdrop_upload_[kind])))) {
+    backdrop_texture_[kind].Reset();
+    backdrop_upload_[kind].Reset();
+    return false;
+  }
+  uint8_t* mapped = nullptr;
+  D3D12_RANGE read_range = {0, 0};
+  if (FAILED(backdrop_upload_[kind]->Map(0, &read_range, reinterpret_cast<void**>(&mapped)))) {
+    backdrop_texture_[kind].Reset();
+    backdrop_upload_[kind].Reset();
+    return false;
+  }
+  for (int y = 0; y < height; ++y) {
+    std::memcpy(mapped + footprint.Offset + size_t(y) * footprint.Footprint.RowPitch,
+                pixels.data() + size_t(y) * width * 4, size_t(width) * 4);
+  }
+  backdrop_upload_[kind]->Unmap(0, nullptr);
+
+  // The upload buffer stays alive for the rest of the run, so the copy
+  // recorded on this submission can never read freed memory.
+  D3D12_TEXTURE_COPY_LOCATION dst;
+  dst.pResource = backdrop_texture_[kind].Get();
+  dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  dst.SubresourceIndex = 0;
+  D3D12_TEXTURE_COPY_LOCATION src;
+  src.pResource = backdrop_upload_[kind].Get();
+  src.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+  src.PlacedFootprint = footprint;
+  SubmitBarriers();
+  deferred_command_list_.D3DCopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
+  PushTransitionBarrier(backdrop_texture_[kind].Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+                        D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  backdrop_width_[kind] = uint32_t(width);
+  backdrop_height_[kind] = uint32_t(height);
+  rex::cvar::SetFlagByName("ge_backdrop_ready", "true");
+  REXGPU_INFO("ge: menu backdrop picture {}x{} loaded from {}", width, height, path.string());
+  return true;
+}
