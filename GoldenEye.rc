// Application icon. The rexglue window class loads it by the name "MAINICON"
// (LoadIconW(hinstance, L"MAINICON") in window_win.cpp) and applies it via
// WM_SETICON, so this is the icon for the .exe, the window title bar, and the
// taskbar. Windows Explorer shows it for the file too.
MAINICON ICON "Icon.ico"

// Version information, from the VERSION file (ge_version_rc.h is generated by
// CMakeLists.txt into the build folder).
#include "ge_version_rc.h"

1 VERSIONINFO
 FILEVERSION GE_VERSION_COMMA
 PRODUCTVERSION GE_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "GoldenEye 007 XBLA PC Recomp"
            VALUE "FileVersion", GE_VERSION_STR
            VALUE "InternalName", "GoldenEye 007"
            VALUE "OriginalFilename", "GoldenEye 007.exe"
            VALUE "ProductName", "GoldenEye 007 XBLA PC Recomp"
            VALUE "ProductVersion", GE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
